---
// Design prototype: "Underwater world". London has flooded; Nigel fixes the leak by the end of the page.
import Scene from "../../components/design/underwater/Scene.astro";
import Tap from "../../components/design/underwater/Tap.astro";
import WavyHeading from "../../components/design/underwater/WavyHeading.astro";

const phone = "020 0000 0000"; // placeholder until Nigel's number is known
const phoneHref = "tel:+442000000000";
const email = "hello@example.com"; // placeholder

const services = [
  {
    slug: "emergency-plumbing",
    title: "Emergency plumbing",
    body: "Leaks, burst pipes and blocked drains, sorted before the water reaches the skirting boards.",
    colour: "var(--sun)",
    shape: "58% 42% 50% 50% / 30% 34% 38% 32%",
    icon: "pipe",
  },
  {
    slug: "boilers-and-heating",
    title: "Boilers and central heating",
    body: "Gas Safe boiler repairs, servicing and new installs, plus radiators and heating that actually heats.",
    colour: "var(--tangerine)",
    shape: "44% 56% 40% 60% / 36% 30% 34% 38%",
    icon: "flame",
  },
  {
    slug: "renovations-and-commercial",
    title: "Renovations and commercial work",
    body: "New bathrooms and kitchens, full renovations, and plumbing for offices and businesses.",
    colour: "var(--magenta-light)",
    shape: "52% 48% 58% 42% / 32% 38% 30% 36%",
    icon: "building",
  },
];

const wave =
  "M0 20Q90 0 180 20T360 20T540 20T720 20T900 20T1080 20T1260 20T1440 20";
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Nigel Bass Plumbing and Heating (underwater concept)</title>
    <meta
      name="description"
      content="Gas Safe registered plumbing and heating engineer based in Enfield, covering all of London. £100 domestic callout."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Shrikhand&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="hero">
      <Scene />
      <div class="hero-copy">
        <WavyHeading lines={["Nigel Bass", "Plumbing and Heating"]} />
        <p class="tagline">
          Something's leaking and the whole street's gone under. Don't panic.
          Nigel's on his way.
        </p>
        <div class="actions">
          <a class="btn btn-sun" href={phoneHref}>Call {phone}</a>
          <a class="btn btn-foam" href="#services">See what Nigel fixes</a>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="intro" aria-labelledby="intro-title">
        <svg class="wave" viewBox="0 0 1440 40" preserveAspectRatio="none" aria-hidden="true">
          <path d={`${wave}V40H0z`} fill="var(--bg)"></path>
          <path d={wave} fill="none" stroke="var(--ink)" stroke-width="5" vector-effect="non-scaling-stroke"></path>
        </svg>
        <div class="wrap intro-grid">
          <div class="panel">
            <h2 id="intro-title">Thirty years of turning the water off</h2>
            <p>
              Nigel Bass has been fixing leaks, boilers and heating systems for
              more than 30 years. He's based in Enfield and works right across
              London, from a dripping tap in Walthamstow to a new boiler in
              Wimbledon.
            </p>
            <p>
              You get the same engineer from first call to final check, and a
              clear price before any work starts.
            </p>
          </div>
          <ul class="facts">
            <li class="fact fact-sun">
              <strong>£100</strong>
              <span>callout for domestic jobs</span>
            </li>
            <li class="fact fact-magenta">
              <strong>Gas Safe</strong>
              <span>registered engineer</span>
              <!-- TODO: add Gas Safe registration number once Nigel provides it -->
            </li>
            <li class="fact fact-tangerine">
              <strong>All of London</strong>
              <span>from a base in Enfield</span>
            </li>
          </ul>
        </div>
      </section>

      <section class="services" id="services" aria-labelledby="services-title">
        <svg class="wave" viewBox="0 0 1440 40" preserveAspectRatio="none" aria-hidden="true">
          <path d={`${wave}V40H0z`} fill="var(--bg)"></path>
          <path d={wave} fill="none" stroke="var(--ink)" stroke-width="5" vector-effect="non-scaling-stroke"></path>
        </svg>
        <div class="wrap">
          <h2 id="services-title" class="section-title">What needs fixing?</h2>
          <ul class="service-list">
            {
              services.map((s) => (
                <li class="service" style={`--c:${s.colour};--shape:${s.shape}`}>
                  <svg class="service-icon" viewBox="0 0 100 100" aria-hidden="true">
                    <g stroke="var(--ink)" stroke-width="5" stroke-linejoin="round" stroke-linecap="round">
                      {s.icon === "pipe" && (
                        <>
                          <rect x="6" y="40" width="88" height="22" rx="4" fill="var(--lagoon)" />
                          <path d="M44 40l6 10-6 12M56 40l-6 10 6 12" fill="var(--foam)" />
                          <path d="M50 36c-8-14-4-24 0-30 4 6 8 16 0 30zM38 34l-14-16M62 34l14-16" fill="var(--foam)" />
                          <circle cx="30" cy="80" r="6" fill="var(--foam)" />
                          <circle cx="70" cy="84" r="4" fill="var(--foam)" />
                        </>
                      )}
                      {s.icon === "flame" && (
                        <>
                          <rect x="10" y="44" width="80" height="46" rx="10" fill="var(--foam)" />
                          <path d="M28 52v30M44 52v30M60 52v30M76 52v30" fill="none" />
                          <path d="M50 40c-18-8-12-26 0-34 0 10 14 12 10 24 6-2 6-8 6-8 4 10-4 20-16 18z" fill="var(--magenta)" />
                        </>
                      )}
                      {s.icon === "building" && (
                        <>
                          <rect x="22" y="14" width="56" height="78" rx="4" fill="var(--foam)" />
                          <path d="M34 28h10M56 28h10M34 44h10M56 44h10M34 60h10M56 60h10" stroke-width="8" />
                          <path d="M42 92V76h16v16" fill="var(--lagoon)" />
                        </>
                      )}
                    </g>
                  </svg>
                  <h3>
                    <a href={`/services/${s.slug}`}>{s.title}</a>
                  </h3>
                  <p>{s.body}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="projects" aria-labelledby="projects-title">
        <svg class="wave" viewBox="0 0 1440 40" preserveAspectRatio="none" aria-hidden="true">
          <path d={`${wave}V40H0z`} fill="var(--bg)"></path>
          <path d={wave} fill="none" stroke="var(--ink)" stroke-width="5" vector-effect="non-scaling-stroke"></path>
        </svg>
        <div class="wrap projects-grid">
          <svg class="office" viewBox="0 0 300 340" aria-hidden="true">
            <g stroke="var(--ink)" stroke-width="6" stroke-linejoin="round">
              <rect x="60" y="30" width="180" height="300" rx="6" fill="var(--violet)"></rect>
              <rect x="40" y="310" width="220" height="30" fill="var(--violet-dark)"></rect>
              {
                [0, 1, 2, 3, 4].flatMap((r) =>
                  [0, 1, 2].map((c) => (
                    <rect
                      x={80 + c * 52}
                      y={50 + r * 52}
                      width="36"
                      height="36"
                      rx="6"
                      fill={(r + c) % 4 === 1 ? "var(--sun)" : "var(--shallow)"}
                      stroke-width="4"
                    />
                  ))
                )
              }
              <path d="M150 30V6M138 6h24" fill="none"></path>
              <path
                d="M114 116c5-8 13-8 18 0-5 8-13 8-18 0zm18 0l7-5v10z"
                fill="var(--magenta)"
                stroke-width="3"></path>
              <path
                d="M166 220c5-8 13-8 18 0-5 8-13 8-18 0zm18 0l7-5v10z"
                fill="var(--tangerine)"
                stroke-width="3"></path>
            </g>
            <circle cx="40" cy="120" r="10" fill="none" stroke="var(--foam)" stroke-width="4"></circle>
            <circle cx="262" cy="70" r="7" fill="none" stroke="var(--foam)" stroke-width="4"></circle>
            <circle cx="270" cy="190" r="12" fill="none" stroke="var(--foam)" stroke-width="4"></circle>
          </svg>
          <div class="panel">
            <h2 id="projects-title">Bigger jobs, same plumber</h2>
            <p>
              Renovations, refits and office or corporate work are planned
              properly and quoted per job. Nigel works with homeowners,
              landlords, builders and facilities managers, and he's still the
              one who turns up.
            </p>
            <ul class="ticks">
              <li>Full bathroom and kitchen refits</li>
              <li>Pipework and heating for renovations</li>
              <li>Office and commercial plumbing</li>
            </ul>
            <a class="btn btn-ink" href="/services/renovations-and-commercial"
              >Renovations and commercial work</a
            >
          </div>
        </div>
      </section>

      <section class="cta" id="contact" aria-labelledby="cta-title">
        <svg class="wave" viewBox="0 0 1440 40" preserveAspectRatio="none" aria-hidden="true">
          <path d={`${wave}V40H0z`} fill="var(--bg)"></path>
          <path d={wave} fill="none" stroke="var(--ink)" stroke-width="5" vector-effect="non-scaling-stroke"></path>
        </svg>
        <div class="sunburst" aria-hidden="true"></div>
        <div class="wrap cta-grid">
          <Tap state="drip" id="cta-tap" class="cta-tap" />
          <div class="cta-copy">
            <p class="status" aria-live="polite">
              <span class="status-leak">Still dripping…</span>
              <span class="status-fixed">Leak fixed. Water's going down.</span>
            </p>
            <h2 id="cta-title">Got a leak? Let's get it fixed.</h2>
            <p>
              Tell Nigel what's going on and he'll get back to you. Domestic
              callouts are £100; bigger projects are quoted per job.
            </p>
            <div class="actions actions-left">
              <a class="btn btn-ink" href="/contact">Send Nigel a message</a>
              <a class="btn btn-foam" href={phoneHref}>Call {phone}</a>
            </div>
            <p class="small">
              Or email <a href={`mailto:${email}`}>{email}</a>
            </p>
          </div>
        </div>
        <svg class="surface" viewBox="0 0 1440 40" preserveAspectRatio="none" aria-hidden="true">
          <path d={`${wave}V40H0z`} fill="var(--lagoon)"></path>
          <path d={wave} fill="none" stroke="var(--ink)" stroke-width="5" vector-effect="non-scaling-stroke"></path>
        </svg>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap">
        <p>
          <strong>Nigel Bass Plumbing and Heating</strong><br />
          Gas Safe registered. Based in Enfield, covering all of London.
        </p>
      </div>
    </footer>

    <script>
      // The tap is fixed once the contact section scrolls into view.
      const tap = document.getElementById("cta-tap");
      const cta = document.getElementById("contact");
      if (tap && cta) {
        new IntersectionObserver(
          ([entry], observer) => {
            if (!entry.isIntersecting) return;
            setTimeout(() => {
              tap.classList.replace("is-drip", "is-fixed");
              cta.classList.add("is-fixed");
            }, 600);
            observer.disconnect();
          },
          { threshold: 0.6 }
        ).observe(cta);
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ink: #22124a;
    --deep: #0a4f6e;
    --lagoon: #0e8a99;
    --shallow: #7fdccb;
    --foam: #eafff7;
    --sun: #ffd43b;
    --tangerine: #ff7f1f;
    --magenta: #e8207a;
    --magenta-light: #ff8fc0;
    --violet: #7b3fe4;
    --violet-dark: #4b2399;
    --bus: #e2352b;
    --lime: #9be15d;
    color-scheme: light;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--deep);
    color: var(--ink);
    font-family: "Bricolage Grotesque", system-ui, sans-serif;
    font-size: 1.125rem;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  h2,
  h3 {
    font-family: "Shrikhand", "Cooper Black", serif;
    font-weight: 400;
    line-height: 1.1;
    margin: 0 0 0.6em;
  }
  h2 {
    font-size: clamp(1.9rem, 5vw, 3rem);
  }
  p {
    margin: 0 0 1em;
  }
  a {
    color: inherit;
  }
  :focus-visible {
    outline: 4px solid var(--sun);
    outline-offset: 3px;
    box-shadow: 0 0 0 8px var(--ink);
    border-radius: 6px;
  }
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 10;
    padding: 0.6rem 1rem;
    background: var(--sun);
    font-weight: 700;
  }
  .skip:focus {
    top: 1rem;
  }
  .wrap {
    width: min(100% - 2rem, 70rem);
    margin-inline: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>

<style>
  /* Hero: deepest water */
  .hero {
    position: relative;
    min-height: max(100svh, 760px);
    background: linear-gradient(var(--lagoon), var(--deep) 70%);
    color: var(--foam);
    overflow: hidden;
  }
  .hero-copy {
    position: relative;
    padding: clamp(7.5rem, 18vh, 11rem) 1rem 0;
    max-width: 62rem;
    margin-inline: auto;
    text-align: center;
  }
  .tagline {
    max-width: 30rem;
    margin: 2.2rem auto 1.6rem;
    font-size: clamp(1.1rem, 2.4vw, 1.35rem);
    font-weight: 600;
    background: var(--ink);
    padding: 0.8rem 1.2rem;
    border-radius: 1.6rem 1.6rem 1.6rem 0.4rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: center;
  }
  .actions-left {
    justify-content: flex-start;
  }
  .btn {
    display: inline-block;
    padding: 0.75rem 1.4rem;
    border: 4px solid var(--ink);
    border-radius: 999px;
    font-weight: 800;
    text-decoration: none;
    color: var(--ink);
    box-shadow: 5px 6px 0 var(--ink);
    transition:
      transform 0.15s,
      box-shadow 0.15s;
  }
  .btn:hover {
    transform: translate(2px, 3px);
    box-shadow: 3px 3px 0 var(--ink);
  }
  .btn-sun {
    background: var(--sun);
  }
  .btn-foam {
    background: var(--foam);
  }
  .btn-ink {
    background: var(--ink);
    color: var(--sun);
    box-shadow: 5px 6px 0 var(--magenta);
  }
  .btn-ink:hover {
    box-shadow: 3px 3px 0 var(--magenta);
  }

  /* Each section is a little shallower than the last */
  section {
    --bg: var(--lagoon);
    position: relative;
    background: var(--bg);
    padding: clamp(3rem, 8vw, 6rem) 0;
  }
  .wave {
    position: absolute;
    left: 0;
    top: 1px;
    width: 100%;
    height: 40px;
    translate: 0 -100%;
  }
  .services {
    --bg: #3cc2b8;
  }
  .projects {
    --bg: var(--shallow);
  }
  .panel {
    background: var(--foam);
    border: 4px solid var(--ink);
    border-radius: 2.2rem 0.6rem 2.2rem 2.2rem;
    padding: clamp(1.4rem, 4vw, 2.4rem);
    box-shadow: 8px 9px 0 var(--ink);
  }
  .panel > :last-child {
    margin-bottom: 0;
  }
  .panel h2 {
    color: var(--magenta);
  }
  .panel p {
    max-width: 38rem;
  }

  /* Intro */
  .intro-grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1.4fr 1fr;
    align-items: center;
  }
  .facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
  }
  .fact {
    border: 4px solid var(--ink);
    padding: 1rem 1.4rem;
    box-shadow: 6px 6px 0 var(--ink);
  }
  .fact strong {
    display: block;
    font-family: "Shrikhand", serif;
    font-weight: 400;
    font-size: 1.8rem;
    line-height: 1.1;
  }
  .fact-sun {
    background: var(--sun);
    border-radius: 60% 40% 50% 50% / 50% 50% 50% 50%;
    rotate: -2deg;
  }
  .fact-magenta {
    background: var(--magenta-light);
    border-radius: 40% 60% 45% 55% / 55% 45% 55% 45%;
    rotate: 1.5deg;
    margin-inline-start: 1.5rem;
  }
  .fact-tangerine {
    background: var(--tangerine);
    border-radius: 55% 45% 60% 40% / 45% 60% 40% 55%;
    rotate: -1deg;
  }
  .fact {
    text-align: center;
  }

  /* Services */
  .section-title {
    text-align: center;
    color: var(--foam);
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    -webkit-text-stroke: 0.1em var(--ink);
    paint-order: stroke fill;
    text-shadow: 0.06em 0.07em 0 var(--ink);
    margin-bottom: 1.4em;
  }
  .service-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 2.4rem 2rem;
  }
  .service {
    position: relative;
    background: var(--c);
    border: 4px solid var(--ink);
    border-radius: var(--shape);
    padding: 2.4rem 2rem 2.6rem;
    text-align: center;
    box-shadow: 7px 8px 0 var(--ink);
  }
  .service:nth-child(2) {
    translate: 0 1.5rem;
  }
  .service:focus-within {
    outline: 4px solid var(--sun);
    outline-offset: 6px;
  }
  .service-icon {
    width: 5.5rem;
    margin: 0 auto 0.8rem;
    display: block;
  }
  .service h3 {
    font-size: 1.55rem;
  }
  .service h3 a {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
  }
  .service h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .service h3 a:focus-visible {
    outline: none;
    box-shadow: none;
  }
  .service p {
    margin: 0 auto;
    max-width: 22rem;
  }

  /* Projects */
  .projects-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) 1.2fr;
    gap: 3rem;
    align-items: center;
  }
  .office {
    width: 100%;
    max-width: 20rem;
    justify-self: center;
    rotate: -4deg;
  }
  .ticks {
    padding: 0;
    margin: 0 0 1.6rem;
    list-style: none;
  }
  .ticks li {
    padding-left: 2rem;
    margin-bottom: 0.4rem;
    background: radial-gradient(
        circle at 0.6rem 50%,
        var(--sun) 0 0.45rem,
        var(--ink) 0.45rem 0.6rem,
        transparent 0.6rem
      )
      no-repeat;
  }

  /* CTA: surfacing into the sun */
  .cta {
    --bg: var(--sun);
    overflow: clip visible;
    padding-bottom: clamp(5rem, 10vw, 8rem);
  }
  .sunburst {
    position: absolute;
    inset: 0;
    background: repeating-conic-gradient(
      from 0deg at 80% 40%,
      #ffc21a 0deg 8deg,
      transparent 8deg 16deg
    );
  }
  .cta-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) 1.3fr;
    gap: 2.5rem;
    align-items: center;
  }
  .cta-tap {
    width: 100%;
    max-width: 16rem;
    justify-self: center;
  }
  .cta-copy {
    background: var(--foam);
    border: 4px solid var(--ink);
    border-radius: 0.6rem 2.4rem 2.4rem 2.4rem;
    padding: clamp(1.4rem, 4vw, 2.4rem);
    box-shadow: 8px 9px 0 var(--magenta);
  }
  .cta-copy h2 {
    color: var(--ink);
  }
  .status {
    display: inline-block;
    font-weight: 800;
    padding: 0.2rem 0.9rem;
    border-radius: 999px;
    border: 3px solid var(--ink);
    background: var(--magenta-light);
  }
  .status-fixed,
  .cta.is-fixed .status-leak {
    display: none;
  }
  .cta.is-fixed .status-fixed {
    display: inline;
  }
  .cta.is-fixed .status {
    background: var(--lime);
  }
  .small {
    margin: 1.4rem 0 0;
    font-size: 1rem;
  }
  .surface {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: clamp(50px, 8vw, 90px);
    transition: height 1.6s ease-out;
  }
  .cta.is-fixed .surface {
    height: 28px;
  }

  .footer {
    background: var(--lagoon);
    color: var(--foam);
    padding: 1rem 0 2.5rem;
    font-size: 1rem;
  }
  .footer p {
    margin: 0;
  }

  @media (max-width: 800px) {
    .intro-grid,
    .projects-grid,
    .cta-grid {
      grid-template-columns: 1fr;
    }
    .fact-magenta {
      margin-inline-start: 0;
    }
    .service:nth-child(2) {
      translate: none;
    }
    .office {
      max-width: 13rem;
    }
    .cta-tap {
      max-width: 10rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .btn,
    .surface {
      transition: none;
    }
  }
</style>
